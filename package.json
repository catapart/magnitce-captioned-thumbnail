{
  "name": "@magnit-ce/captioned-thumbnail",
  "version": "0.0.5",
  "description": "A custom html element that displays an image or icon with a caption and interactive components.",
  "main": "dist/captioned-thumbnail.umd.js",
  "module": "dist/captioned-thumbnail.js",
  "types": "dist/captioned-thumbnail.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build-tests": "vite build --config vite.config.tests.ts",
    "changeset": "npx @changesets/cli",
    "release": "npm run build && npx @changesets/cli publish"
  },
  "keywords": [
    "custom",
    "element",
    "html",
    "browser",     "image",     "icon",     "thumbnail",     "figure",     "caption",     "select",     "list item"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.27.7",
    "@magnit-ce/test-runner": "^0.0.8",
    "@rollup/plugin-terser": "^1.0.0",
    "ce-part-utils": "^0.0.4",
    "changesets": "^1.0.2",
    "glob": "^13.0.0",
    "typescript": "^5.5.3",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.5.4"
  },
  "author": "catapart",
  "license": "CC0-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/catapart/magnitce-captioned-thumbnail"
  }
}
